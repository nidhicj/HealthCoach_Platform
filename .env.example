# --- Postgres ---
# COMPOSE_PROJECT_NAME/POSTGRES_PORT keep each git worktree's local Postgres
# container isolated from the others — set both uniquely per worktree so
# docker-compose.yml never needs worktree-specific edits (and never conflicts).
COMPOSE_PROJECT_NAME=tapas_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:localdevpassword@localhost:5432/tapas_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres:localdevpassword@localhost:5432/tapas_test

# --- Auth ---
JWT_PRIVATE_KEY=<ES256 PEM private key — generate: openssl ecparam -name prime256v1 -genkey -noout -out priv.pem>
JWT_PUBLIC_KEY=<ES256 PEM public key — generate: openssl ec -in priv.pem -pubout -out pub.pem>
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- LLM ---
OPENROUTER_API_KEY=<from openrouter.ai>
LLM_CALL_ENCRYPTION_KEY=<generate: openssl rand -base64 32>
DEMOGRAPHICS_ENCRYPTION_KEY=<generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=<from Cloudflare dashboard → R2 → Overview — shown as Account ID>
R2_ACCESS_KEY_ID=<from R2 → Manage R2 API tokens → Create API token>
R2_SECRET_ACCESS_KEY=<from R2 API token creation — only shown once>
R2_BUCKET_NAME=<bucket name — free tier: 10 GB storage, 1 M writes/mo, 10 M reads/mo, zero egress>

# --- Observability ---
SENTRY_DSN=<from sentry.io>
APP_ENV=dev

# --- Payments (Razorpay, test mode — Unit_003 PHASE-05, D-1/D-2) ---
# Production credentials are never read from this file — each HC pastes their
# own key_id/key_secret/webhook_secret into the in-app connection flow
# (POST /api/hc/payment-account/connect), stored encrypted per-HC in
# hc_payment_accounts. These three are for LOCAL DEV ONLY: PHASE-05's seed
# step reads them to pre-populate the dev HC's hc_payment_accounts row so you
# can test end-to-end without clicking through the connection UI yourself.
# Generate from your own Razorpay account: Dashboard → Settings → API Keys
# (test mode toggle on) for the first two; Dashboard → Settings → Webhooks →
# Add New Webhook, URL = {API_BASE_URL}/api/payments/webhook, for the third —
# you choose that value yourself when creating the webhook.
RAZORPAY_TEST_KEY_ID=<from Razorpay Dashboard → Settings → API Keys, test mode>
RAZORPAY_TEST_KEY_SECRET=<same page — shown once only, regenerate in Razorpay if lost>
RAZORPAY_TEST_WEBHOOK_SECRET=<your own choice, entered when creating the webhook in Razorpay Dashboard → Settings → Webhooks>
RAZORPAY_CREDENTIALS_ENCRYPTION_KEY=<generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# --- Scheduler ---
SCHEDULER_SECRET=<generate: openssl rand -hex 32>

# --- App ---
APP_VERSION=0.1.0

