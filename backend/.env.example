RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=noreply@tapas.health

# Razorpay TEST-mode credentials for scripts/seed_payment_account.py (local dev
# convenience only — production HC credentials only ever arrive through
# POST /api/hc/payment-account/connect, never via env vars).
RAZORPAY_TEST_KEY_ID=rzp_test_your_key_id
RAZORPAY_TEST_KEY_SECRET=your_test_key_secret
RAZORPAY_TEST_WEBHOOK_SECRET=your_test_webhook_secret

# Fernet key encrypting hc_payment_accounts.credentials (key_id/key_secret/
# webhook_secret) at rest — distinct from DEMOGRAPHICS_ENCRYPTION_KEY so
# payment secrets and demographics never share a key. If left unset, this
# falls back to a key hardcoded in backend/src/db/encrypted_json.py, which is
# fine for local dev but MUST be set to a real generated value before any real
# deploy — it's the encryption key protecting every connected HC's Razorpay
# webhook_secret, the entire signature verification boundary on
# POST /api/payments/webhook.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RAZORPAY_CREDENTIALS_ENCRYPTION_KEY=your_generated_fernet_key
